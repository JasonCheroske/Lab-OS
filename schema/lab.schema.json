{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/lab-os/lab.schema.json",
  "title": "Lab OS Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "labId",
    "name",
    "maturityStage",
    "modules",
    "governance",
    "requiredChecks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "labId": {
      "type": "string",
      "minLength": 3
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "maturityStage": {
      "type": "string",
      "enum": ["experiment", "poc", "pilot", "production"]
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "reality", "delta", "behavior", "evidence"],
      "properties": {
        "intent": { "type": "boolean" },
        "reality": { "type": "boolean" },
        "delta": { "type": "boolean" },
        "behavior": { "type": "boolean" },
        "evidence": { "type": "boolean" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "roles", "approvalMatrix", "overrides", "editorAttributionPolicy"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["strict", "hybrid", "lightweight"]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "approvalMatrix": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["changeType", "enabled", "reason", "approvedBy", "approvedAt", "reviewAfter"],
            "properties": {
              "changeType": { "type": "string" },
              "enabled": { "type": "boolean" },
              "reason": { "type": "string" },
              "approvedBy": { "type": "string" },
              "approvedAt": { "type": "string" },
              "reviewAfter": { "type": "string" }
            }
          }
        },
        "editorAttributionPolicy": {
          "type": "string",
          "description": "Separates human editorial authority from automation roles.",
          "enum": ["human_only"]
        }
      }
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
